# ─────────────────────────────────────────────────────────────
# Societal Innovation Portal · env template. Copy to .env (never commit .env).
# Same DATABASE_URL is shared by apps/web (Prisma) and apps/ai (asyncpg).
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres + pgvector) ──
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"   # for prisma migrate

# ── Auth (NextAuth v4) ──
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ── File storage (Supabase Storage; Cloudinary is the approved fallback) ──
SUPABASE_URL="https://YOUR.supabase.co"
SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."        # server-side signed uploads only
STORAGE_BUCKET="evidence"

# ── AI service link (apps/web -> apps/ai) ──
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_KEY="shared-secret-between-web-and-ai"

# ── AI service internals (apps/ai) ──
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"   # 384-dim, do not change
LLM_PROVIDER="groq"                    # groq | gemini | ollama (ollama = offline demo)
GROQ_API_KEY="..."
GEMINI_API_KEY="..."
OLLAMA_BASE_URL="http://localhost:11434"
DEDUP_THRESHOLD="0.82"
SEED_MODE="false"                      # true = deterministic matches for rehearsed demos

# ── Email notifications (SMTP / Resend free) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="app-password"
EMAIL_FROM="Societal Innovation Portal <you@gmail.com>"

# ── Optional: Bhashini (local language / voice, C3) ──
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
